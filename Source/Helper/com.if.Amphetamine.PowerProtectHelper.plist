<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.if.Amphetamine.PowerProtectHelper</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/com.if.Amphetamine.PowerProtectHelper</string>
	</array>
	<key>inetdCompatibility</key>
	<dict>
		<key>Wait</key>
		<false/>
	</dict>
	<key>Sockets</key>
	<dict>
		<key>Listener</key>
		<dict>
			<key>SockPathName</key>
			<string>/var/run/com.if.Amphetamine.PowerProtectHelper.sock</string>
			<!-- 0666: any local user can connect, including standard users. -->
			<key>SockPathMode</key>
			<integer>438</integer>
		</dict>
	</dict>
	<key>StandardErrorPath</key>
	<string>/dev/null</string>
</dict>
</plist>
